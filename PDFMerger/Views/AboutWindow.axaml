<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="https://codewf.com"
        x:Class="PdfMerger.Views.AboutWindow"
        Title="About PDFMerger"
        Width="360"
        Height="260"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="{DynamicResource SystemBackgroundBrush}">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Image Grid.Row="0"
           Source="avares://PDFMerger/Assets/icon.png"
           Width="48"
           Height="48"
           HorizontalAlignment="Center"
           Margin="0,0,0,8" />

    <TextBlock Grid.Row="1"
               Text="PDFMerger"
               FontSize="20"
               FontWeight="Bold"
               HorizontalAlignment="Center" />

    <TextBlock Grid.Row="2"
               x:Name="VersionTextBlock"
               Text="Version 2.0.0"
               FontSize="14"
               Foreground="{DynamicResource SystemAccentColor}"
               HorizontalAlignment="Center"
               Margin="0,4,0,0" />

    <TextBlock Grid.Row="3"
               Text="© 2026 Leison. All rights reserved."
               FontSize="12"
               Foreground="{DynamicResource SystemTextColor}"
               HorizontalAlignment="Center"
               Opacity="0.7"
               Margin="0,8,0,0" />

    <TextBox Grid.Row="4"
             Text="https://github.com/359193585/PdfMerger"
             IsReadOnly="True"
             Background="Transparent"
             BorderThickness="0"
             FontSize="12"
             Foreground="{DynamicResource SystemTextColor}"
             HorizontalAlignment="Center"
             Opacity="0.7"
             Margin="0,8,0,0"
             Cursor="IBeam"
             TextWrapping="Wrap" />


    <StackPanel Grid.Row="5"
                Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
      <Button Content="{c:I18n MainWindow_CheckForUpdates}"
              Click="OnCheckForUpdatesClick"
              Background="#4A90D9"
              Foreground="White"
              CornerRadius="6"
              Padding="12,6" />
      <TextBlock x:Name="UpdateStatusTextBlock"
                 Text=""
                 VerticalAlignment="Center"
                 FontSize="12"
                 Foreground="#2C3E50" />
    </StackPanel>

    <TextBlock Grid.Row="6"
               Text="Simple PDF Merger Desktop Tool"
               FontSize="12"
               Foreground="{DynamicResource SystemTextColor}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Opacity="0.6" />

    <Button Grid.Row="7"
            Content="OK"
            Width="80"
            Height="30"
            HorizontalAlignment="Center"
            HorizontalContentAlignment ="Center"
            Click="OnOkClick" />
  </Grid>
</Window>
